{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "typeRoots": [".millennium/types", "node_modules/@types"],
    "paths": {"millennium": [".millennium/lsp/ts"]}
  },
  "include": ["frontend/**/*", ".millennium/**/*.d.ts"]
}
